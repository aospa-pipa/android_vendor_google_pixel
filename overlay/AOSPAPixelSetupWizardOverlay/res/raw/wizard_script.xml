<?xml version="1.0" encoding="UTF-8"?>
<!--
    Legend:
        REQUIRED     Must be included in final scripting solution
        RECOMMENDED  Associated with an optional feature; may have
                     dependencies on other recommended actions
        CUSTOMIZABLE Available for modification, within UX standards

    Each top-level comment tag applies to one or more script instructions, until the next top-level
    comment tag. A comment tag on a result code applies only to that result code.

    The wizard:uris recorded here have the inconvenience of being generated by hand, but they allow
    for the full spread of launch flags (we need FLAG_ACTIVITY_NEW_TASK [0x10000000]), where the
    <intent> tag processed by Intent.parseIntent() does not.

    adb shell am to-intent-uri -a com.android.setupwizard.WELCOME -f 0x10000000 \-\-ez firstRun true
-->
<WizardScript xmlns:wizard="http://schemas.android.com/apk/res/com.google.android.setupwizard"
    wizard:version="2">

    <!-- Preliminary setup for OEMs [CUSTOMIZABLE] -->
    <WizardAction id="oem_pre_setup"
        wizard:uri="intent:#Intent;action=com.android.setupwizard.OEM_PRE_SETUP;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.setupwizard.OemPreSetupContract">
        <result wizard:name="start_retail"
            wizard:resultCode="109"
            wizard:action="start_retail" />
        <result wizard:action="welcome" />
    </WizardAction>

    <!-- Retail demo factory setup -->
    <WizardAction id="start_retail"
        wizard:uri="intent:#Intent;action=com.android.setupwizard.START_RETAIL;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.pixelsetupwizard.FactoryProvisioningContract">
        <result wizard:action="exit" />
    </WizardAction>

    <!-- Welcome screen with language selection [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="welcome"
        wizard:uri="intent:#Intent;package=com.google.android.pixel.setupwizard;action=com.android.setupwizard.WELCOME;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.setupwizard.user.WelcomeContract">
        <result wizard:name="start_qr_provision"
            wizard:resultCode="101"
            wizard:action="check_user_unlock_qr" />
        <result wizard:name="dpm_user_complete"
            wizard:resultCode="111"
            wizard:action="check_user_unlock_dpm_user_complete" />
        <result wizard:name="dpm_profile_complete"
            wizard:resultCode="112"
            wizard:action="check_user_unlock_dpm_user_complete" />
        <result wizard:name="four_corner"
            wizard:resultCode="102"
            wizard:action="early_exit" />
        <result wizard:name="check_user_unlock_work_setup_interrupted_qr_scan"
            wizard:resultCode="114"
            wizard:action="check_user_unlock_work_setup_interrupted_qr_scan" />
        <result wizard:name="check_user_unlock_work_setup_interrupted_consumer_flow"
            wizard:resultCode="115"
            wizard:action="check_user_unlock_work_setup_interrupted_consumer_flow" />
        <result wizard:name="voice_setup"
            wizard:resultCode="121"
            wizard:action="check_user_unlock_voice_setup" />
        <result wizard:name="check_user_unlock_nfc"
            wizard:resultCode="124"
            wizard:action="check_user_unlock_nfc" />
        <result wizard:name="check_user_unlock_work_setup_interrupted_nfc_tap"
            wizard:resultCode="125"
            wizard:action="check_user_unlock_work_setup_interrupted_nfc_tap" />
        <result wizard:name="provisioning_extras_not_saved"
            wizard:resultCode="128"
            wizard:action="check_user_unlock_fail_provisioning" />
        <result wizard:action="check_user_unlock" />
    </WizardAction>

    <WizardAction id="check_user_unlock_fail_provisioning"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CHECK_USER_UNLOCK;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.CheckUserUnlockContract">
        <result wizard:action="fail_provisioning" />
    </WizardAction>

    <!-- Device is restarted in this step -->
    <WizardAction id="fail_provisioning"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.SHOW_PROVISIONING_ERROR;end"
        wizard:node="contract:com.google.android.setupwizard.contract.provision.ShowProvisioningErrorContract" />

    <WizardAction id="check_user_unlock_work_setup_interrupted_nfc_tap"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CHECK_USER_UNLOCK;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.CheckUserUnlockContract">
        <result wizard:action="work_setup_interrupted_nfc_tap" />
    </WizardAction>

    <WizardAction id="work_setup_interrupted_nfc_tap"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.WORK_SETUP_INTERRUPTED;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.WorkSetupInterruptedContract">
        <result wizard:name="continue_start_nfc_provisioning"
            wizard:resultCode="1"
            wizard:action="nfc_provision_flow" />
        <result wizard:action="factory_reset" />
    </WizardAction>

    <WizardAction id="check_user_unlock_nfc"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CHECK_USER_UNLOCK;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.CheckUserUnlockContract">
        <result wizard:action="nfc_provision_flow" />
    </WizardAction>

    <WizardAction id="nfc_provision_flow"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_nfc_provision_flow">
        <result wizard:action="oem_post_setup" />
    </WizardAction>

    <WizardAction id="check_user_unlock_work_setup_interrupted_qr_scan"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CHECK_USER_UNLOCK;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.CheckUserUnlockContract" />

    <WizardAction id="work_setup_interrupted_qr_scan"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.WORK_SETUP_INTERRUPTED;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.WorkSetupInterruptedContract">
        <result wizard:name="continue_start_qr_scan"
            wizard:resultCode="1"
            wizard:action="check_user_unlock_qr" />
        <result wizard:action="factory_reset" />
    </WizardAction>

    <WizardAction id="check_user_unlock_work_setup_interrupted_consumer_flow"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CHECK_USER_UNLOCK;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.CheckUserUnlockContract" />

    <WizardAction id="work_setup_interrupted_consumer_flow"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.WORK_SETUP_INTERRUPTED;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.WorkSetupInterruptedContract">
        <result wizard:name="continue_start_consumer_flow"
            wizard:resultCode="1"
            wizard:action="check_user_unlock" />
        <result wizard:action="factory_reset" />
    </WizardAction>

    <WizardAction id="check_user_unlock_qr"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CHECK_USER_UNLOCK;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.CheckUserUnlockContract">
        <result wizard:action="qr_provision_flow" />
    </WizardAction>

    <WizardAction id="check_user_unlock_dpm_user_complete"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CHECK_USER_UNLOCK;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.CheckUserUnlockContract">
        <result wizard:action="oem_post_setup" />
    </WizardAction>

    <WizardAction id="check_user_unlock"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CHECK_USER_UNLOCK;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.CheckUserUnlockContract">
        <result wizard:action="slots_selection" />
    </WizardAction>

    <WizardAction id="check_user_unlock_voice_setup"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CHECK_USER_UNLOCK;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.CheckUserUnlockContract" />

    <!-- Voice Access onboarding -->
    <WizardAction id="voice_setup"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.VOICE_SETUP;end"
        wizard:node="contract:com.google.android.setupwizard.contract.accessibility.VoiceSetupWrapperContract" />

    <!-- Check which existing profile should be enabled [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="slots_selection"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.SLOTS_SELECTION;end"
        wizard:node="contract:com.google.android.setupwizard.contract.carrier.SlotsSelectionContract">
        <result wizard:name="skip"
            wizard:resultCode="1"
            wizard:action="sim_missing" />
        <result wizard:action="carrier_setup" />
    </WizardAction>

    <!-- Notify user if expected SIM is not found [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="sim_missing"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.SIM_MISSING;end"
        wizard:node="contract:com.google.android.setupwizard.contract.carrier.SimMissingContract">
        <result wizard:name="esim"
            wizard:resultCode="101"
            wizard:action="esim_intro" />
        <result wizard:name="esim_only"
            wizard:resultCode="102"
            wizard:action="carrier_setup" />
        <result wizard:action="sim_ready" />
    </WizardAction>

    <WizardAction id="sim_ready"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.SIM_READY;end"
        wizard:node="contract:com.google.android.setupwizard.contract.carrier.SimReadyContract">
        <result wizard:action="carrier_setup" />
    </WizardAction>

    <WizardAction id="esim_intro"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.ESIM_INTRO;end"
        wizard:node="contract:com.google.android.setupwizard.contract.carrier.EsimIntroContract" />

    <!-- Activate carrier services [RECOMMENDED] -->
    <WizardAction id="carrier_setup"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CARRIER_SETUP;end"
        wizard:node="contract:com.google.android.setupwizard.contract.carrier.CarrierSetupWrapperContract">
        <result wizard:name="all_subscriptions_completed"
            wizard:resultCode="98765"
            wizard:action="sim_setup" />
        <result wizard:name="skip"
            wizard:resultCode="1"
            wizard:action="sim_setup" />

        <!-- Return to carrier_setup to check for other subscriptions for multi-SIM -->
        <result wizard:action="carrier_setup" />
    </WizardAction>

    <!-- On multi-SIM devices, choose which SIM to use for voice, data, and text [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="sim_setup"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.SIM_SETUP;end"
        wizard:node="contract:com.google.android.setupwizard.contract.carrier.SimSetupContract" />

    <!-- Security warning (for enterprise) [RECOMMENDED] -->
    <WizardAction id="device_owner_warning"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.DEVICE_OWNER_WARNING;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.DeviceOwnerWarningContract">
        <result wizard:name="skip"
            wizard:resultCode="1"
            wizard:action="check_frp" />
    </WizardAction>

    <!-- Factory reset should cause a reboot, but if it returns unexpectedly, continue on to check_frp -->
    <WizardAction id="factory_reset"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.FACTORY_RESET;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.FactoryResetContract" />

    <!-- Wait to check factory reset protection status [RECOMMENDED] -->
    <!-- forceUseUi extra passed to force it to load the original screen which
    in this case is usually invisible rather than the orchestrator loading
    screen which will cause it show always show a loading screen for a very
    short amount of time. -->
    <WizardAction id="check_frp"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.CHECK_FRP;B.com.android.onboarding.forceUseUi=true;end"
        wizard:node="contract:com.google.android.setupwizard.contract.account.CheckFrpContract" />

    <!-- Locale & region Setup [PIXEL] -->
    <WizardAction id="locale_setup"
        wizard:uri="intent:#Intent;action=com.google.android.pixel.setupwizard.LOCALE_SETUP;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.pixelsetupwizard.LocaleSetupContract" />

    <!-- A quick setup experience [REQUIRED] -->
    <WizardAction id="check_quick_start"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.CHECK_QUICK_START;B.com.android.onboarding.canUseBackgroundTasks=true;end"
        wizard:node="contract:com.google.android.setupwizard.contract.quickstart.CheckQuickStartContract">
        <!-- TODO(b/228790268): flip the conditions to go through quick start by default -->
        <result wizard:name="quick_start"
            wizard:resultCode="101"
            wizard:action="quick_start_flow" />
        <result wizard:action="connect_and_update" />
    </WizardAction>

    <!-- Quick start setup flow [REQUIRED] -->
    <WizardAction id="quick_start_flow"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_quick_start_flow">
        <result wizard:action="oem_post_setup" />
    </WizardAction>

    <!-- Network selection and packages update [REQUIRED, CUSTOMIZABLE] -->
    <WizardAction id="connect_and_update"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_connect_and_update_flow">
        <result wizard:name="no_connection"
            wizard:resultCode="1"
            wizard:action="no_network_flow" />
    </WizardAction>

    <!-- Voice Access download is required -->
    <WizardAction id="voice_access"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.VOICE_DOWNLOAD;end"
        wizard:node="contract:com.google.android.setupwizard.contract.accessibility.VoiceDownloadWrapperContract" />

    <!-- Zero touch provisioning (for enterprise). This feature depends on Android Checkin and Early update. Place this action after Android Checkin and Early update, but before restore. [REQUIRED]. -->
    <WizardAction id="zero_touch"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_zero_touch_flow">
        <result wizard:name="dpm_user_complete"
            wizard:resultCode="111"
            wizard:action="post_dpm_user_flow" />
        <!-- The restore flow would be set to cloud for COPE devices if the result code returned the adding personal account. -->
        <result wizard:name="add_personal_account_after_work_profile"
            wizard:resultCode="120"
            wizard:action="add_personal_account_after_work_profile" />
        <result wizard:name="financed_device_provisioning_complete"
            wizard:resultCode="121"
            wizard:action="setup_as_new_flow" />
        <result wizard:name="work_profile_setup"
            wizard:resultCode="122"
            wizard:action="work_profile_setup" />
        <result wizard:name="device_owner_setup"
            wizard:resultCode="123"
            wizard:action="post_dpm_user_flow" />
        <!-- GmsCore will handle ZeroTouch. Go to setup_as_new flow, it will handle ZeroTouch and FRP -->
        <result wizard:name="gmscore_zero_touch"
            wizard:resultCode="116"
            wizard:action="setup_as_new_flow" />
    </WizardAction>

    <!-- Restore from an existing account or device [RECOMMENDED, CUSTOMIZABLE] -->
    <WizardAction id="unified_restore_flow"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_unified_restore_flow">
        <result wizard:action="oem_post_setup" />
    </WizardAction>

    <WizardAction id="work_profile_setup"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_post_dpm_provision_finalization_flow">
        <result wizard:action="transition_to_personal_profile_setup" />
    </WizardAction>

    <!-- Set up without a network connection [RECOMMENDED] -->
    <WizardAction id="no_network_flow"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_no_network_flow">
        <result wizard:action="oem_post_setup" />
    </WizardAction>

    <WizardAction id="transition_to_personal_profile_setup"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.TRANSITION_TO_PERSONAL_PROFILE_SETUP;end"
        wizard:node="contract:com.google.android.setupwizard.contract.provision.TransitionToPersonalProfileSetupContract">
        <result wizard:name="skip_add_personal_account"
            wizard:resultCode="1"
            wizard:action="no_account_flow" />
        <result wizard:action="add_personal_account_after_work_profile" />
    </WizardAction>

    <!-- Add personal account after work profile provisioning [REQUIRED] -->
    <WizardAction id="add_personal_account_after_work_profile"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_account_flow">
        <result wizard:action="oem_post_setup" />
    </WizardAction>

    <!-- Setup as new [REQUIRED] -->
    <WizardAction id="setup_as_new_flow" wizard:flow="SetupAsNewFlow"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_account_flow">
        <result wizard:action="oem_post_setup" />
    </WizardAction>

    <!-- Set up without an account [REQUIRED] -->
    <WizardAction id="no_account_flow"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_no_account_flow">
        <result wizard:action="oem_post_setup" />
    </WizardAction>

    <!-- Flow to run after a user-led device policy managed setup. [RECOMMENDED] -->
    <WizardAction id="post_dpm_user_flow"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_post_dpm_user_flow">
        <result wizard:action="oem_post_setup" />
    </WizardAction>

    <!-- QR provision flow (for enterprise) [RECOMMENDED] -->
    <WizardAction id="qr_provision_flow"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_qr_provision_flow">
        <result wizard:action="oem_post_setup" />
    </WizardAction>

    <!-- OEM completion [CUSTOMIZABLE] -->
    <WizardAction id="oem_post_setup"
        wizard:uri="intent:#Intent;action=com.android.setupwizard.OEM_POST_SETUP;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.setupwizard.OemPostSetupContract" />

    <!-- Enterprise provisioning finalization flow. Required only in init setup flow. [REQUIRED] -->
    <WizardAction id="enterprise_finalization_flow"
        wizard:script="android.resource://com.google.android.pixel.setupwizard/raw/wizard_script_post_dpm_provision_finalization_flow">
    </WizardAction>

    <!-- Google kid account setup. Must be the last setup action. [REQUIRED] -->
    <WizardAction id="kid_post_setup"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.KID_POST_SETUP;end"
        wizard:node="contract:com.google.android.setupwizard.contract.account.KidPostSetupWrapperContract" />

    <!-- Setup the system light/dark mode. Must be after the restore final_hold action and at the end of setup flow. [REQUIRED] -->
    <WizardAction id="day_night_mode_setup"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.google.android.setupwizard.DAY_NIGHT_MODE_SETUP;end"
        wizard:node="contract:com.google.android.setupwizard.contract.user.DarkModeContract" />


    <!-- Parental Setup page [PIXEL] -->
    <WizardAction id="parental_setup" wizard:ifLifecycle="default"
        wizard:uri="intent:#Intent;action=com.google.android.pixel.setupwizard.PARENTAL_SETUP_WRAPPER;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.pixelsetupwizard.ParentalNoticeWrapperContract" />

    <!-- Leave Setup Wizard [REQUIRED] -->
    <WizardAction id="exit"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.EXIT;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.setupwizard.SetupWizardExitActivityContract">
        <result wizard:action="END_OF_SCRIPT" />
    </WizardAction>

    <!-- Leave Setup Wizard for early exit of four corner [REQUIRED] -->
    <WizardAction id="early_exit"
        wizard:uri="intent:#Intent;package=com.google.android.setupwizard;action=com.android.setupwizard.FOUR_CORNER_EXIT;end"
        wizard:node="contract:com.google.android.libraries.onboarding.contracts.setupwizard.FourCornerExitContract" />

    <WizardAction id="END_OF_SCRIPT" />
</WizardScript>
